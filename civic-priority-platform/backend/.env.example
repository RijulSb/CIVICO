ENVIRONMENT=production
APP_NAME=civico-backend
APP_VERSION=0.1.0
API_V1_PREFIX=/api/v1
LOG_LEVEL=INFO

# Required production secrets; inject through the deployment platform secret manager.
JWT_SECRET_KEY=replace-with-a-long-random-value
CIVICO_API_KEY=replace-with-a-long-random-value

# Required production database.
DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@HOST:5432/DBNAME
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=10
DATABASE_POOL_TIMEOUT=30

# Comma-separated exact browser origins.
CORS_ORIGINS=https://your-frontend.example.com

RATE_LIMIT_PER_MINUTE=60
MAX_CONTENT_LENGTH_BYTES=10485760

# Optional integrations.
REDIS_URL=
QDRANT_URL=
OLLAMA_BASE_URL=
OLLAMA_MODEL=
OPENCAGE_API_KEY=
MAPBOX_GEOCODING_KEY=
GROQ_API_KEY=
OPENAI_API_KEY=
HUGGINGFACE_API_KEY=
