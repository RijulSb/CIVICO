# ---------------------------------------------------------------------------
# CIVICO Backend Environment Configuration & Security Keys
# Copy to .env.local for local development
# ---------------------------------------------------------------------------

# App Information
APP_NAME=civico-backend
APP_VERSION=0.1.1
ENVIRONMENT=development
LOG_LEVEL=INFO

# API Router Prefix
API_V1_PREFIX=/api/v1

# Security & Authentication Keys
# CIVICO_API_KEY protects administrative routes like /api/v1/optimization and /api/v1/reports
CIVICO_API_KEY=civ_dev_secret_key_8f39a01c89e24b5d

# JWT_SECRET_KEY is used for signing citizen/official user session tokens (64-character string recommended)
JWT_SECRET_KEY=development-only-change-me-0123456789abcdef0123456789abcdef

# CORS Allowed Origins (Comma-separated)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://civico.vercel.app

# Rate Limiting & Input Validation Limits
RATE_LIMIT_PER_MINUTE=10
MAX_CONTENT_LENGTH_BYTES=10485760  # 10 MB limit

# Database Connection URL (PostgreSQL + asyncpg)
DATABASE_URL=postgresql+asyncpg://civico:change-me-local-only@127.0.0.1:5432/civico
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=10
DATABASE_POOL_TIMEOUT=30.0

# Optional Third-Party Integration & Geocoding Keys
# OPENAI_API_KEY=sk-proj-your-openai-api-key-here
# OPENCAGE_API_KEY=your-opencage-geocoding-api-key
# MAPBOX_GEOCODING_KEY=your-mapbox-access-token

# Voice Transcription API Keys (optional; leave blank to use local civic intent fallback)
GROQ_API_KEY=
OPENAI_API_KEY=
HUGGINGFACE_API_KEY=
